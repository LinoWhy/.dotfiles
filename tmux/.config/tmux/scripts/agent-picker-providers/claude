#!/usr/bin/env sh
set -eu

runtime_dir=${1:?usage: claude RUNTIME_DIR}
panes_file="$runtime_dir/panes.jsonl"
processes_file="$runtime_dir/processes.jsonl"
sessions_dir="${HOME:-}/.claude/sessions"

[ -f "$panes_file" ] || exit 0
[ -f "$processes_file" ] || exit 0
[ -d "$sessions_dir" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

set -- "$sessions_dir"/*.json
[ -f "$1" ] || exit 0

jq -sc \
    --slurpfile panes "$panes_file" \
    --slurpfile processes "$processes_file" '
    ($panes | map({key: .pane_pid, value: .}) | from_entries) as $pane_by_pid |
    ($processes | map({key: .pid, value: .ppid}) | from_entries) as $parent_by_pid |

    def pane_for_pid($pid):
        def climb($current):
            if $pane_by_pid[$current] then $pane_by_pid[$current]
            elif $parent_by_pid[$current]? and
                 $parent_by_pid[$current] != $current and
                 $parent_by_pid[$current] != "0" then
                climb($parent_by_pid[$current])
            else null
            end;
        climb($pid);

    def picker_status:
        if . == "idle" then "idle"
        elif . == "busy" or . == "shell" then "working"
        elif . == "waiting" then "approval"
        else "idle"
        end;

    .[] |
    select(.pid != null) |
    (.pid | tostring) as $pid |
    pane_for_pid($pid) as $pane |
    select($pane != null) |
    {
        pane_id: $pane.pane_id,
        session_id: $pane.session_id,
        window_id: $pane.window_id,
        agent: "claude",
        name: (.name // ""),
        status: ((.status // "") | picker_status),
        target: $pane.target,
        path: $pane.path
    }
' "$@"
