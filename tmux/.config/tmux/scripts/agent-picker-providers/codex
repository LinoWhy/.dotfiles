#!/usr/bin/env sh
set -eu

file_mtime() {
    stat -c '%Y' "$1" 2>/dev/null ||
        stat -f '%m' "$1" 2>/dev/null ||
        printf '0\n'
}

index_file="${HOME:-}/.codex/session_index.jsonl"

command -v jq >/dev/null 2>&1 || exit 0

pane_rows=$(
    awk -F '\t' '
$1 == "pane" {
    command = tolower($6)
    sub(/^.*\//, "", command)
    sub(/^-/, "", command)
    if (command != "codex" && index(command, "codex-") != 1)
        next

    pane_count++
    pane_order[pane_count] = $2
    pane_by_pid[$5] = $2
    pane_session[$2] = $3
    pane_window[$2] = $4
    pane_target[$2] = $7
    pane_path[$2] = $8
    next
}
$1 == "process" {
    parent[$2] = $3
    command = tolower($4)
    sub(/^.*\//, "", command)
    if (command == "codex" || index(command, "codex-") == 1) {
        codex_count++
        codex_pid[codex_count] = $2
    }
}
END {
    for (i = 1; i <= codex_count; i++) {
        pid = codex_pid[i]
        ancestor = pid
        while (!(ancestor in pane_by_pid) && ancestor in parent && parent[ancestor] != ancestor && parent[ancestor] != 0)
            ancestor = parent[ancestor]

        if (ancestor in pane_by_pid)
            pane_codex_pid[pane_by_pid[ancestor]] = pid
    }

    for (i = 1; i <= pane_count; i++) {
        pane = pane_order[i]
        printf "%s\t%s\t%s\t%s\t%s\t%s\n", \
            pane, pane_session[pane], pane_window[pane], pane_codex_pid[pane], \
            pane_target[pane], pane_path[pane]
    }
}'
)

pids=$(
    printf '%s\n' "$pane_rows" |
        awk -F '\t' '$4 != "" && !seen[$4]++ { pids = pids separator $4; separator = "," } END { print pids }'
)

rollout_rows=''
if [ -n "$pids" ] && command -v lsof >/dev/null 2>&1; then
    rollout_rows=$(
        lsof -nP -Fpn -p "$pids" 2>/dev/null |
            awk '
/^p[0-9]+$/ {
    pid = substr($0, 2)
    next
}
/^n/ && /\/\.codex\/sessions\// && /\.jsonl$/ {
    path = substr($0, 2)
    file = path
    sub(/^.*\//, "", file)
    sub(/\.jsonl$/, "", file)
    uuid = substr(file, length(file) - 35)
    parts = split(uuid, segment, "-")
    if (parts == 5 && length(segment[1]) == 8 && length(segment[2]) == 4 && \
        length(segment[3]) == 4 && length(segment[4]) == 4 && length(segment[5]) == 12)
        printf "%s\t%s\t%s\n", pid, uuid, path
}' |
            while IFS="$(printf '\t')" read -r pid session_id path; do
                [ -n "$pid" ] || continue
                printf '%s\t%s\t%s\n' "$pid" "$(file_mtime "$path")" "$session_id"
            done
    )
fi

name_rows=''
if [ -f "$index_file" ]; then
    name_rows=$(
        jq -r '
            [
                .id,
                ((.thread_name // "") | gsub("[\\t\\r\\n]"; " "))
            ] | @tsv
        ' "$index_file" 2>/dev/null || true
    )
fi

{
    printf '%s\n' "$pane_rows" | awk -F '\t' 'NF >= 6 { print "pane\t" $0 }'
    printf '%s\n' "$rollout_rows" | awk -F '\t' 'NF >= 3 { print "rollout\t" $0 }'
    printf '%s\n' "$name_rows" | awk -F '\t' 'NF >= 2 { print "name\t" $0 }'
} |
    awk -F '\t' '
$1 == "pane" {
    pane_count++
    pane[pane_count] = $2
    pane_session[$2] = $3
    pane_window[$2] = $4
    pane_pid[$2] = $5
    pane_target[$2] = $6
    pane_path[$2] = $7
    next
}
$1 == "rollout" {
    if (!($2 in newest_mtime) || $3 >= newest_mtime[$2]) {
        newest_mtime[$2] = $3
        session_by_pid[$2] = $4
    }
    next
}
$1 == "name" {
    name_by_session[$2] = $3
}
END {
    for (i = 1; i <= pane_count; i++) {
        current_pane = pane[i]
        session = session_by_pid[pane_pid[current_pane]]
        printf "%s\t%s\t%s\tcodex\t%s\t%s\t%s\n", \
            current_pane, pane_session[current_pane], pane_window[current_pane], \
            name_by_session[session], pane_target[current_pane], pane_path[current_pane]
    }
}'
