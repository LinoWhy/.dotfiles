#!/usr/bin/env sh
set -eu

file_mtime() {
    stat -c '%Y' "$1" 2>/dev/null ||
        stat -f '%m' "$1" 2>/dev/null ||
        printf '0\n'
}

runtime_dir=${1:?usage: codex RUNTIME_DIR}
panes_file="$runtime_dir/panes.jsonl"
processes_file="$runtime_dir/processes.jsonl"
index_file="${HOME:-}/.codex/session_index.jsonl"

[ -f "$panes_file" ] || exit 0
[ -f "$processes_file" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/agent-picker-codex.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
candidates_file="$work_dir/candidates.jsonl"
rollout_candidates_file="$work_dir/rollout-candidates.tsv"
rollouts_file="$work_dir/rollouts.json"
names_file="$work_dir/names.json"

jq -cn \
    --slurpfile panes "$panes_file" \
    --slurpfile processes "$processes_file" '
    def codex_command:
        split("/") | last | ascii_downcase | test("^codex(-|$)");

    ($panes | map({key: .pane_pid, value: .}) | from_entries) as $pane_by_pid |
    ($processes | map({key: .pid, value: .ppid}) | from_entries) as $parent_by_pid |

    def pane_for_pid($pid):
        def climb($current; $seen):
            if $pane_by_pid[$current] then $pane_by_pid[$current]
            elif ($seen | index($current)) then null
            elif $parent_by_pid[$current]? and
                 $parent_by_pid[$current] != $current and
                 $parent_by_pid[$current] != "0" then
                climb($parent_by_pid[$current]; $seen + [$current])
            else null
            end;
        climb($pid; []);

    ([ $processes[] |
       select(.command | codex_command) |
       {pid, pane: pane_for_pid(.pid)} |
       select(.pane != null)
     ] | reduce .[] as $match ({}; .[$match.pane.pane_id] = $match.pid)) as $pid_by_pane |

    $panes[] |
    select(.command | codex_command) |
    . + {pid: ($pid_by_pane[.pane_id] // "")}
' >"$candidates_file"

pids=$(jq -sr '[.[] | .pid | select(. != "")] | unique | join(",")' "$candidates_file")
: >"$rollout_candidates_file"
if [ -n "$pids" ] && command -v lsof >/dev/null 2>&1; then
    lsof -nP -Fpn -p "$pids" 2>/dev/null |
        awk '
/^p[0-9]+$/ {
    pid = substr($0, 2)
    next
}
/^n/ && /\/\.codex\/sessions\// && /\.jsonl$/ {
    path = substr($0, 2)
    file = path
    sub(/^.*\//, "", file)
    sub(/\.jsonl$/, "", file)
    uuid = substr(file, length(file) - 35)
    parts = split(uuid, segment, "-")
    if (parts == 5 && length(segment[1]) == 8 && length(segment[2]) == 4 && \
        length(segment[3]) == 4 && length(segment[4]) == 4 && length(segment[5]) == 12)
        printf "%s\t%s\t%s\n", pid, uuid, path
}' |
        while IFS="$(printf '\t')" read -r pid session_id path; do
            [ -n "$pid" ] || continue
            printf '%s\t%s\t%s\t%s\n' \
                "$pid" "$session_id" "$path" "$(file_mtime "$path")" \
                >>"$rollout_candidates_file"
        done
fi

jq -Rn '
    [inputs |
        split("\t") |
        select(length == 4) |
        {pid: .[0], session_id: .[1], path: .[2], mtime: (.[3] | tonumber)}
    ] |
    group_by(.pid) |
    map(max_by(.mtime) | del(.mtime))
' "$rollout_candidates_file" >"$rollouts_file"

if [ -f "$index_file" ]; then
    jq -sc '
        reduce .[] as $session ({}; .[$session.id] = ($session.thread_name // ""))
    ' "$index_file" 2>/dev/null >"$names_file" || printf '{}\n' >"$names_file"
else
    printf '{}\n' >"$names_file"
fi

jq -cn \
    --slurpfile candidates "$candidates_file" \
    --slurpfile rollouts "$rollouts_file" \
    --slurpfile names "$names_file" '
    ($rollouts[0] | map({key: .pid, value: .}) | from_entries) as $rollout_by_pid |
    ($names[0]) as $name_by_session |

    $candidates[] |
    . as $pane |
    ($rollout_by_pid[$pane.pid] // {}) as $rollout |
    ($rollout.session_id // "") as $rollout_session |
    {
        pane_id: $pane.pane_id,
        session_id: $pane.session_id,
        window_id: $pane.window_id,
        agent: "codex",
        name: ($name_by_session[$rollout_session] // ""),
        target: $pane.target,
        path: $pane.path
    }
'
