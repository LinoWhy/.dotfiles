#!/usr/bin/env python3
"""Provide Codex panes and names to Agent Picker."""

from __future__ import annotations

import json
import os
import selectors
import subprocess
import sys
import time
from dataclasses import dataclass


APP_SERVER_TIMEOUT_SECONDS = 1.5
TMUX_SEPARATOR = "\x1c"


@dataclass
class Pane:
    pane_id: str
    session_id: str
    window_id: str
    target: str
    path: str
    thread_ids: tuple[str, ...] = ()


def process_name(command: str) -> str:
    name = os.path.basename(command)
    if name.startswith("-"):
        name = name[1:]
    return name.lower()


def read_panes() -> list[Pane]:
    panes: list[Pane] = []

    for line in sys.stdin:
        fields = line.rstrip("\n").split("\t")
        if fields[0] == "pane" and len(fields) >= 8:
            if process_name(fields[5]) != "codex":
                continue
            panes.append(
                Pane(
                    pane_id=fields[1],
                    session_id=fields[2],
                    window_id=fields[3],
                    target=fields[6],
                    path=fields[7],
                )
            )

    return panes


def bind_thread_ids(panes: list[Pane]) -> None:
    try:
        result = subprocess.run(
            [
                "tmux",
                "list-panes",
                "-a",
                "-F",
                f"#{{pane_id}}{TMUX_SEPARATOR}"
                f"#{{@agent_picker_codex_session_id}}{TMUX_SEPARATOR}"
                "#{@agent_picker_codex_session_ids}",
            ],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except OSError:
        return

    bindings: dict[str, tuple[str, ...]] = {}
    # str.splitlines() also treats U+001C as a line boundary, but U+001C is
    # deliberately our field separator. Split only on the actual newline.
    for line in result.stdout.split("\n"):
        fields = line.split(TMUX_SEPARATOR)
        if len(fields) != 3:
            continue

        thread_ids: list[str] = []
        try:
            history = json.loads(fields[2]) if fields[2] else []
        except (json.JSONDecodeError, TypeError):
            history = []
        if isinstance(history, list):
            thread_ids.extend(
                thread_id
                for thread_id in history
                if isinstance(thread_id, str) and thread_id
            )
        if fields[1] and fields[1] not in thread_ids:
            thread_ids.append(fields[1])
        if thread_ids:
            bindings[fields[0]] = tuple(thread_ids[:8])

    for pane in panes:
        pane.thread_ids = bindings.get(pane.pane_id, ())


def send(process: subprocess.Popen[bytes], message: dict[str, object]) -> None:
    assert process.stdin is not None
    process.stdin.write(json.dumps(message, separators=(",", ":")).encode() + b"\n")
    process.stdin.flush()


class JsonLineReader:
    def __init__(self, process: subprocess.Popen[bytes]) -> None:
        assert process.stdout is not None
        self.stdout = process.stdout
        self.buffer = bytearray()
        self.selector = selectors.DefaultSelector()
        self.selector.register(self.stdout, selectors.EVENT_READ)

    def close(self) -> None:
        self.selector.close()

    def receive(
        self, deadline: float, expected_ids: set[int]
    ) -> dict[int, dict[str, object]]:
        responses: dict[int, dict[str, object]] = {}
        while expected_ids - responses.keys():
            while b"\n" in self.buffer:
                line, _, remainder = self.buffer.partition(b"\n")
                self.buffer = bytearray(remainder)
                try:
                    message = json.loads(line)
                except (json.JSONDecodeError, TypeError, UnicodeDecodeError):
                    continue
                response_id = message.get("id")
                if isinstance(response_id, int) and response_id in expected_ids:
                    responses[response_id] = message

            if not expected_ids - responses.keys():
                break
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not self.selector.select(remaining):
                break
            chunk = os.read(self.stdout.fileno(), 65536)
            if not chunk:
                break
            self.buffer.extend(chunk)
        return responses


def query_names(thread_ids: list[str]) -> dict[str, str]:
    if not thread_ids:
        return {}

    process = subprocess.Popen(
        ["codex", "app-server"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    reader = JsonLineReader(process)
    deadline = time.monotonic() + APP_SERVER_TIMEOUT_SECONDS

    try:
        send(
            process,
            {
                "id": 0,
                "method": "initialize",
                "params": {
                    "clientInfo": {
                        "name": "agent_picker",
                        "title": "Agent Picker",
                        "version": "1.0.0",
                    }
                },
            },
        )
        initialized = reader.receive(deadline, {0})
        if 0 not in initialized or "error" in initialized[0]:
            return {}

        send(process, {"method": "initialized", "params": {}})
        request_threads: dict[int, str] = {}
        for request_id, thread_id in enumerate(thread_ids, start=1):
            request_threads[request_id] = thread_id
            send(
                process,
                {
                    "id": request_id,
                    "method": "thread/read",
                    "params": {"threadId": thread_id, "includeTurns": False},
                },
            )

        responses = reader.receive(deadline, set(request_threads))
        names: dict[str, str] = {}
        for request_id, thread_id in request_threads.items():
            result = responses.get(request_id, {}).get("result")
            thread = result.get("thread") if isinstance(result, dict) else None
            if not isinstance(thread, dict):
                continue
            name = thread.get("name")
            names[thread_id] = " ".join(name.split()) if isinstance(name, str) else ""
        return names
    finally:
        reader.close()
        if process.poll() is None:
            process.terminate()
        try:
            process.wait(timeout=0.2)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def output(panes: list[Pane], names: dict[str, str]) -> None:
    for pane in panes:
        name = next(
            (names[thread_id] for thread_id in pane.thread_ids if thread_id in names),
            "",
        )
        fields = (
            pane.pane_id,
            pane.session_id,
            pane.window_id,
            "codex",
            name,
            pane.target,
            pane.path,
        )
        print("\t".join(fields))


def main() -> int:
    panes = read_panes()
    if not panes:
        return 0

    bind_thread_ids(panes)
    thread_ids = list(
        dict.fromkeys(thread_id for pane in panes for thread_id in pane.thread_ids)
    )
    try:
        names = query_names(thread_ids)
    except (OSError, BrokenPipeError, subprocess.SubprocessError):
        names = {}
    output(panes, names)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
