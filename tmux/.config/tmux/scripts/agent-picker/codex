#!/usr/bin/env python3
"""Provide Codex panes and status-line names to Agent Picker."""

from __future__ import annotations

import os
import re
import subprocess
import sys
from dataclasses import dataclass


STATUS_SEPARATOR = " · "
ANSI_ESCAPE = re.compile(
    r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07]*(?:\x07|\x1b\\)|[@-_])"
)


@dataclass
class Pane:
    pane_id: str
    session_id: str
    window_id: str
    pid: str
    command: str
    target: str
    path: str


def process_name(command: str) -> str:
    name = os.path.basename(command)
    if name.startswith("-"):
        name = name[1:]
    return name.lower()


def read_panes() -> list[Pane]:
    panes_by_pid: dict[str, Pane] = {}
    parents: dict[str, str] = {}
    codex_pids: list[str] = []

    for line in sys.stdin:
        fields = line.rstrip("\n").split("\t")
        if fields[0] == "pane" and len(fields) >= 8:
            panes_by_pid[fields[4]] = Pane(
                pane_id=fields[1],
                session_id=fields[2],
                window_id=fields[3],
                pid=fields[4],
                command=fields[5],
                target=fields[6],
                path=fields[7],
            )
        elif fields[0] == "process" and len(fields) >= 4:
            parents[fields[1]] = fields[2]
            if process_name(fields[3]) == "codex":
                codex_pids.append(fields[1])

    panes: dict[str, Pane] = {
        pane.pane_id: pane
        for pane in panes_by_pid.values()
        if process_name(pane.command) == "codex"
    }
    for pid in codex_pids:
        while pid not in panes_by_pid and pid in parents and parents[pid] != pid:
            pid = parents[pid]
        if pid in panes_by_pid:
            pane = panes_by_pid[pid]
            panes[pane.pane_id] = pane

    return list(panes.values())


def read_statusline_name(pane_id: str) -> str:
    try:
        result = subprocess.run(
            ["tmux", "capture-pane", "-pJ", "-t", pane_id],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except OSError:
        return ""

    if result.returncode:
        return ""

    lines = result.stdout.splitlines()
    if not lines:
        return ""
    fields = ANSI_ESCAPE.sub("", lines[-1]).split(STATUS_SEPARATOR)
    if len(fields) < 2:
        return ""
    return " ".join(fields[1].split())


def output(panes: list[Pane]) -> None:
    for pane in panes:
        fields = (
            pane.pane_id,
            pane.session_id,
            pane.window_id,
            "codex",
            read_statusline_name(pane.pane_id),
            pane.target,
            pane.path,
            "0" if process_name(pane.command) == "codex" else "1",
        )
        print("\t".join(fields))


def main() -> int:
    panes = read_panes()
    if not panes:
        return 0

    output(panes)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
