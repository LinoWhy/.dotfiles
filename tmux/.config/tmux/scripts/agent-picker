#!/usr/bin/env sh
set -eu

message() {
    printf 'agent-picker: %s\n' "$1" >&2
    tmux display-message "agent-picker: $1" 2>/dev/null || true
}

command -v fzf >/dev/null 2>&1 || {
    message 'fzf not found'
    exit 1
}

rows=$(
    tmux list-panes -a \
        -F '#{pane_id}|#{session_id}|#{window_id}|#{pane_current_command}|#{session_name}:#{window_index}.#{pane_index}|#{pane_current_path}' |
        awk -F '|' -v home="${HOME:-}" '
BEGIN {
    tab = sprintf("%c", 9)
    split("claude codex", names, " ")
    for (i in names) agents[names[i]] = 1
}
{
    command = tolower($4)
    sub(/^.*\//, "", command)
    sub(/^-/, "", command)
    path = $6
    if (home != "") {
        if (path == home)
            path = "~"
        else if (index(path, home "/") == 1)
            path = "~" substr(path, length(home) + 1)
    }

    for (agent in agents) {
        if (command == agent || index(command, agent "-") == 1) {
            count++
            pane[count] = $1
            session[count] = $2
            window[count] = $3
            agent_name[count] = agent
            target[count] = $5
            pane_path[count] = path
            if (length(agent) > agent_width) agent_width = length(agent)
            if (length($5) > target_width) target_width = length($5)
            next
        }
    }
}
END {
    format = "%-" agent_width "s | %-" target_width "s | %s\n"
    for (i = 1; i <= count; i++) {
        printf "%s%s%s%s%s%s", pane[i], tab, session[i], tab, window[i], tab
        printf format, agent_name[i], target[i], pane_path[i]
    }
}'
)

[ -n "$rows" ] || {
    message 'no agent panes'
    exit 0
}

selected=$(
    printf '%s\n' "$rows" |
        fzf \
            --delimiter='\t' \
            --with-nth=4.. \
            --layout=reverse \
            --prompt='agent > ' || true
)
[ -n "$selected" ] || exit 0

tab=$(printf '\t')
IFS="$tab" read -r pane session window _ <<EOF
$selected
EOF

tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1 || {
    message 'pane disappeared'
    exit 0
}

tmux switch-client -t "$session"
tmux select-window -t "$window"
tmux select-pane -t "$pane"
