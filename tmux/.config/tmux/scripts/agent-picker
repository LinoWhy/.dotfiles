#!/usr/bin/env sh
set -eu

message() {
    printf 'agent-picker: %s\n' "$1" >&2
    tmux display-message "agent-picker: $1" 2>/dev/null || true
}

build_runtime() {
    snapshot_dir=$1
    panes_file="$snapshot_dir/panes.jsonl"
    processes_file="$snapshot_dir/processes.jsonl"
    separator=$(printf '\034')
    format="#{pane_id}${separator}#{session_id}${separator}#{window_id}${separator}#{pane_pid}${separator}#{pane_current_command}${separator}#{session_name}${separator}#{window_index}${separator}#{pane_index}${separator}#{pane_current_path}"

    tmux list-panes -a -F "$format" |
        jq -Rrc --arg separator "$separator" '
            split($separator) |
            select(length == 9) |
            {
                pane_id: .[0],
                session_id: .[1],
                window_id: .[2],
                pane_pid: .[3],
                command: .[4],
                target: (.[5] + ":" + .[6] + "." + .[7]),
                path: .[8]
            }
        ' >"$panes_file"

    ps -axo pid=,ppid=,comm= |
        jq -Rrc '
            capture("^\\s*(?<pid>[0-9]+)\\s+(?<ppid>[0-9]+)\\s+(?<command>\\S+)") |
            {pid, ppid, command}
        ' >"$processes_file"
}

command -v fzf >/dev/null 2>&1 || {
    message 'fzf not found'
    exit 1
}
command -v jq >/dev/null 2>&1 || {
    message 'jq not found'
    exit 1
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
provider_dir="$script_dir/agent-picker-providers"
runtime_dir=$(mktemp -d "${TMPDIR:-/tmp}/agent-picker.XXXXXX")
trap 'rm -rf "$runtime_dir"' EXIT HUP INT TERM

build_runtime "$runtime_dir"

raw_rows=$(
    # Provider contract: PROVIDER RUNTIME_DIR -> one agent record per JSONL line.
    for provider in codex claude; do
        "$provider_dir/$provider" "$runtime_dir"
    done
)

# Catppuccin Macchiato green (#A6DA95) and peach (#F5A97F).
codex_color=$(printf '\033[38;2;%d;%d;%dm' 0xA6 0xDA 0x95)
claude_color=$(printf '\033[38;2;%d;%d;%dm' 0xF5 0xA9 0x7F)

rows=$(
    printf '%s\n' "$raw_rows" |
        jq -Rr \
            --arg home "${HOME:-}" \
            '
            fromjson? |
            select(type == "object") |
            . as $row |
            select(
                (["pane_id", "session_id", "window_id", "agent", "name", "target", "path"] | all(. as $key | $row[$key] | type == "string")) and
                (.agent == "codex" or .agent == "claude")
            ) |
            .path as $path |
            if $home != "" and $path == $home then .path = "~"
            elif $home != "" and ($path | startswith($home + "/")) then .path = "~" + ($path | ltrimstr($home))
            else .
            end |
            .name |= gsub("[\\t\\r\\n]"; " ") |
            .target |= gsub("[\\t\\r\\n]"; " ") |
            .path |= gsub("[\\t\\r\\n]"; " ") |
            [.pane_id, .session_id, .window_id, .agent, .name, .target, .path] | @tsv
        ' 2>/dev/null |
        awk -F '\t' -v codex_color="$codex_color" -v claude_color="$claude_color" '
BEGIN {
    color["codex"] = codex_color
    color["claude"] = claude_color
    reset = sprintf("%c[0m", 27)
}
NF >= 7 {
    count++
    pane[count] = $1
    session[count] = $2
    window[count] = $3
    agent[count] = $4
    name[count] = $5
    target[count] = $6
    path[count] = $7

    if (length(agent[count]) > agent_width) agent_width = length(agent[count])
    if (length(name[count]) > name_width) name_width = length(name[count])
    if (length(target[count]) > target_width) target_width = length(target[count])
}
END {
    tab = sprintf("%c", 9)
    format = "%-" agent_width "s │ %-" name_width "s │ %-" target_width "s │ %s"
    for (i = 1; i <= count; i++) {
        printf "%s%s%s%s%s%s", pane[i], tab, session[i], tab, window[i], tab
        printf "%s", color[agent[i]]
        printf format, agent[i], name[i], target[i], path[i]
        printf "%s\n", reset
    }
}'
)

[ -n "$rows" ] || {
    message 'no agent panes'
    exit 0
}

selected=$(
    printf '%s\n' "$rows" |
        fzf \
            --ansi \
            --delimiter='\t' \
            --with-nth=4.. \
            --layout=reverse \
            --prompt='agent > ' || true
)
[ -n "$selected" ] || exit 0

tab=$(printf '\t')
IFS="$tab" read -r pane session window _ <<EOF
$selected
EOF

tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1 || {
    message 'pane disappeared'
    exit 0
}

tmux switch-client -t "$session"
tmux select-window -t "$window"
tmux select-pane -t "$pane"
