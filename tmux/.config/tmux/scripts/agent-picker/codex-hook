#!/usr/bin/env sh

# Bind Codex's official session ID to the current tmux pane.
command -v jq >/dev/null 2>&1 || exit 0
command -v tmux >/dev/null 2>&1 || exit 0

case "${TMUX_PANE:-}" in
    %*) ;;
    *) exit 0 ;;
esac
printf '%s\n' "$TMUX_PANE" | awk '/^%[0-9]+$/ { valid = 1 } END { exit !valid }' || exit 0

session_id=$(
    jq -er '
        select(.hook_event_name == "SessionStart")
        | .session_id
        | select(
            type == "string"
            and length > 0
            and length <= 256
            and (test("[\t\r\n\u001c]") | not)
        )
    ' 2>/dev/null
) || exit 0

session_ids=$(tmux show-options -p -t "$TMUX_PANE" -v @agent_picker_codex_session_ids 2>/dev/null) \
    || session_ids='[]'
session_ids=$(
    printf '%s\n' "${session_ids:-[]}" \
        | jq -cer --arg session_id "$session_id" '
            (if type == "array" then . else [] end)
            | [$session_id] + [.[] | select(type == "string" and . != $session_id)]
            | .[:8]
        ' 2>/dev/null
) || exit 0

tmux set-option -p -t "$TMUX_PANE" @agent_picker_codex_session_ids "$session_ids" 2>/dev/null \
    || exit 0
tmux set-option -p -t "$TMUX_PANE" @agent_picker_codex_session_id "$session_id" 2>/dev/null || exit 0
exit 0
