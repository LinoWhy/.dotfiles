#!/usr/bin/env sh

# Bind Codex's official session ID to the current tmux pane.
command -v jq >/dev/null 2>&1 || exit 0
command -v ps >/dev/null 2>&1 || exit 0
command -v tmux >/dev/null 2>&1 || exit 0

case "${TMUX_PANE:-}" in
    %*) ;;
    *) exit 0 ;;
esac
printf '%s\n' "$TMUX_PANE" | awk '/^%[0-9]+$/ { valid = 1 } END { exit !valid }' || exit 0

session_id=$(
    jq -er '
        select(.hook_event_name == "SessionStart")
        | .session_id
        | select(
            type == "string"
            and length > 0
            and length <= 256
            and (test("[\\t\\r\\n\\u001c]") | not)
        )
    ' 2>/dev/null
) || exit 0

pid=$PPID
codex_pid=''
depth=0
while [ "$pid" -gt 1 ] 2>/dev/null && [ "$depth" -lt 64 ]; do
    process=$(ps -p "$pid" -o ppid= -o comm= 2>/dev/null) || break
    set -- $process
    parent=${1:-}
    command=${2:-}
    command=${command##*/}
    command=${command#-}

    if [ "$command" = "codex" ]; then
        codex_pid=$pid
        break
    fi
    case "$parent" in
        '' | *[!0-9]*) break ;;
    esac
    [ "$parent" != "$pid" ] || break
    pid=$parent
    depth=$((depth + 1))
done

[ -n "$codex_pid" ] || exit 0
tmux set-option -p -t "$TMUX_PANE" @agent_picker_codex_session_id "$session_id" 2>/dev/null || exit 0
tmux set-option -p -t "$TMUX_PANE" @agent_picker_codex_pid "$codex_pid" 2>/dev/null || true
exit 0
