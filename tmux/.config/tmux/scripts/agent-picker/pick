#!/usr/bin/env sh
set -eu

message() {
    printf 'agent-picker: %s\n' "$1" >&2
    tmux display-message "agent-picker: $1" 2>/dev/null || true
}

build_runtime() {
    separator=$(printf '\034')
    format="#{pane_id}${separator}#{session_id}${separator}#{window_id}${separator}#{pane_pid}${separator}#{pane_current_command}${separator}#{session_name}${separator}#{window_index}${separator}#{pane_index}${separator}#{pane_current_path}"

    tmux list-panes -a -F "$format" |
        awk -F "$separator" 'BEGIN { OFS = "\t" }
        NF == 9 {
            gsub(/[\t\r\n]/, " ", $5)
            gsub(/[\t\r\n]/, " ", $6)
            gsub(/[\t\r\n]/, " ", $9)
            print "pane", $1, $2, $3, $4, $5, $6 ":" $7 "." $8, $9
        }'

    ps -axo pid=,ppid=,comm= |
        awk 'BEGIN { OFS = "\t" }
        NF >= 3 {
            gsub(/[\t\r\n]/, " ", $3)
            print "process", $1, $2, $3
        }'
}

command -v fzf >/dev/null 2>&1 || {
    message 'fzf not found'
    exit 1
}
command -v jq >/dev/null 2>&1 || {
    message 'jq not found'
    exit 1
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
runtime_rows=$(build_runtime)

raw_rows=$(
    # Runtime input (TSV):
    #   pane, pane_id, session_id, window_id, pane_pid, command, target, path
    #   process, pid, ppid, command
    # Provider output (TSV): pane_id, session_id, window_id, agent, name, target, path
    for provider in codex claude; do
        printf '%s\n' "$runtime_rows" | "$script_dir/$provider"
    done
)

# Catppuccin Macchiato green (#A6DA95) and peach (#F5A97F).
codex_color=$(printf '\033[38;2;%d;%d;%dm' 0xA6 0xDA 0x95)
claude_color=$(printf '\033[38;2;%d;%d;%dm' 0xF5 0xA9 0x7F)

rows=$(
    printf '%s\n' "$raw_rows" |
        awk -F '\t' \
            -v home="${HOME:-}" \
            -v codex_color="$codex_color" \
            -v claude_color="$claude_color" '
BEGIN {
    color["codex"] = codex_color
    color["claude"] = claude_color
    reset = sprintf("%c[0m", 27)
}
NF == 7 && ($4 == "codex" || $4 == "claude") {
    count++
    pane[count] = $1
    session[count] = $2
    window[count] = $3
    agent[count] = $4
    name[count] = $5
    target[count] = $6
    path[count] = $7

    gsub(/[\t\r\n]/, " ", name[count])
    gsub(/[\t\r\n]/, " ", target[count])
    gsub(/[\t\r\n]/, " ", path[count])
    if (home != "") {
        if (path[count] == home)
            path[count] = "~"
        else if (index(path[count], home "/") == 1)
            path[count] = "~" substr(path[count], length(home) + 1)
    }

    if (length(agent[count]) > agent_width) agent_width = length(agent[count])
    if (length(name[count]) > name_width) name_width = length(name[count])
    if (length(target[count]) > target_width) target_width = length(target[count])
}
END {
    tab = sprintf("%c", 9)
    format = "%-" agent_width "s │ %-" name_width "s │ %-" target_width "s │ %s"
    for (i = 1; i <= count; i++) {
        printf "%s%s%s%s%s%s", pane[i], tab, session[i], tab, window[i], tab
        printf "%s", color[agent[i]]
        printf format, agent[i], name[i], target[i], path[i]
        printf "%s\n", reset
    }
}'
)

[ -n "$rows" ] || {
    message 'no agent panes'
    exit 0
}

selected=$(
    printf '%s\n' "$rows" |
        fzf \
            --ansi \
            --delimiter='\t' \
            --with-nth=4.. \
            --layout=reverse \
            --prompt='agent > ' || true
)
[ -n "$selected" ] || exit 0

tab=$(printf '\t')
IFS="$tab" read -r pane session window _ <<EOF
$selected
EOF

tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1 || {
    message 'pane disappeared'
    exit 0
}

tmux switch-client -t "$session"
tmux select-window -t "$window"
tmux select-pane -t "$pane"
